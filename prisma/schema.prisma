generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  products Order[]
}

model Product {
  id     Int     @id @default(autoincrement())
  name   String
  price  Int
  stock  Int
  orders Order[]
}

model Order {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int

  User    User    @relation(fields: [userId], references: [id])
  Product Product @relation(fields: [productId], references: [id])
}
